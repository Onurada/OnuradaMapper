<Window x:Class="OnuradaMapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OnuradaMapper.ViewModels"
        xmlns:v="clr-namespace:OnuradaMapper.Views"
        Title="Onurada Mapper" Width="1220" Height="840" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Job.IsRunning, Converter={StaticResource TaskbarState}}" ProgressValue="{Binding Job.Progress, Converter={StaticResource Fraction}}" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><v:LibraryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NewMapViewModel}"><v:NewMapView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueViewModel}"><v:QueueView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}"><v:ToolsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupViewModel}"><v:SetupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- navigation -->
        <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,20,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrandGradient}">
                        <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="18" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Onurada Mapper" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Beat Saber · auto maps" FontSize="11" Style="{StaticResource SubText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Command="{Binding OpenUpdateCommand}" Margin="0,0,0,10" HorizontalAlignment="Stretch" Background="#33FF4FA3"
                            Visibility="{Binding UpdateText, Converter={StaticResource EmptyVis}}">
                        <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" FontSize="12" />
                    </Button>
                    <Button Command="{Binding LaunchGameCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Margin="0,0,10,0" />
                            <TextBlock Text="{DynamicResource LaunchGame}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="8,8,0,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="#2BB673" Visibility="{Binding GameRunning, Converter={StaticResource BoolVis}}" />
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="#707070" Visibility="{Binding GameRunning, Converter={StaticResource NotBoolVis}}" />
                        <TextBlock FontSize="11" Style="{StaticResource SubText}" Text="{DynamicResource GameOpen}" Visibility="{Binding GameRunning, Converter={StaticResource BoolVis}}" />
                        <TextBlock FontSize="11" Style="{StaticResource SubText}" Text="{DynamicResource GameClosed}" Visibility="{Binding GameRunning, Converter={StaticResource NotBoolVis}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Version, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Margin="8,10,0,0" Style="{StaticResource SubText}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,6">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Width="28" />
                                <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding Selected.Page}" Focusable="False" />
            <v:JobPanel Grid.Row="1" DataContext="{Binding Job}" Visibility="{Binding HasJob, Converter={StaticResource BoolVis}}" />
            <!-- drop hint -->
            <Border x:Name="DropHint" Grid.RowSpan="2" Background="#CC101018" Visibility="Collapsed" IsHitTestVisible="False">
                <Border BorderBrush="{StaticResource BrandGradient}" BorderThickness="3" CornerRadius="16" Margin="40">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="48" HorizontalAlignment="Center" Foreground="White" />
                        <TextBlock Text="{DynamicResource DropHere}" FontSize="22" Foreground="White" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
