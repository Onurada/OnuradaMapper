<Application x:Class="OnuradaMapper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:OnuradaMapper.Views"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <v:StepGlyph x:Key="StepGlyph" />
            <v:StepBrush x:Key="StepBrush" />
            <v:OkGlyph x:Key="OkGlyph" />
            <v:IntIs x:Key="IntIs" />
            <v:IntVis x:Key="IntVis" />
            <v:BoolVis x:Key="BoolVis" />
            <v:BoolVis x:Key="NotBoolVis" Invert="True" />
            <v:Not x:Key="Not" />
            <v:HexBrush x:Key="HexBrush" />
            <v:EmptyVis x:Key="EmptyVis" />
            <v:Percent x:Key="Indeterminate" />
            <v:TaskbarState x:Key="TaskbarState" />
            <v:Fraction x:Key="Fraction" />
            <v:Thumb x:Key="Thumb" />

            <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <SolidColorBrush x:Key="Brand" Color="#FF4FA3" />
            <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF4FA3" Offset="0" />
                <GradientStop Color="#B48CFF" Offset="0.55" />
                <GradientStop Color="#4FC3FF" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="SubText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,10,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="Icon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Icons}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
