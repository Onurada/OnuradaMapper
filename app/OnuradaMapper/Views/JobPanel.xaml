<UserControl x:Class="OnuradaMapper.Views.JobPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource LayerFillColorDefaultBrush}" Height="300">
        <Grid Margin="20,12,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{DynamicResource BtnCancel}" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                    <Button Content="{DynamicResource BtnClose}" Command="{Binding CloseCommand}" Visibility="{Binding IsRunning, Converter={StaticResource NotBoolVis}}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource SubText}" />
                </StackPanel>
            </DockPanel>
            <ProgressBar Grid.Row="1" Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,8,0,10" Foreground="{StaticResource Brand}" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding State, Converter={StaticResource StepGlyph}}" Foreground="{Binding State, Converter={StaticResource StepBrush}}" Style="{StaticResource Icon}" FontSize="13" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   Visibility="{Binding Detail, Converter={StaticResource EmptyVis}}" ToolTip="{Binding Detail}" />
                                        <ProgressBar Height="3" Maximum="100" Value="{Binding Progress}" Margin="0,3,0,0" IsIndeterminate="{Binding Progress, Converter={StaticResource Indeterminate}}"
                                                     Visibility="{Binding State, Converter={StaticResource IntVis}, ConverterParameter=1}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBox x:Name="LogBox" Grid.Column="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" TextChanged="LogBox_TextChanged" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
