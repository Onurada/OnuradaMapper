<UserControl x:Class="OnuradaMapper.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="980" HorizontalAlignment="Left">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource LibRefresh}" /></StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{DynamicResource ToTitle}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource SubText}" />
                </StackPanel>
            </DockPanel>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" />

            <!-- storage -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ToStorage}" Style="{StaticResource CardHeader}" />
                    <TextBlock Text="{Binding DriveText}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" />
                                    <TextBlock Grid.Column="1" Text="{Binding Mb, StringFormat={}{0:N0} MB}" TextAlignment="Right" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource SubText}" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding CleanStemsCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource ToCleanStems}" /></StackPanel>
                        </Button>
                        <TextBlock Text="{Binding StemsText}" Style="{StaticResource SubText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding CleanDownloadsCommand}" Content="{DynamicResource ToCleanDownloads}" Margin="8,0,0,0" />
                        <TextBlock Text="{DynamicResource ToCleanDownloadsHint}" Style="{StaticResource SubText}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- backups -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ToBackups}" Style="{StaticResource CardHeader}" />
                    <ListView ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="260">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource ColTitle}" Width="420" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="{DynamicResource ToDate}" Width="150" DisplayMemberBinding="{Binding Date, StringFormat=yyyy-MM-dd HH:mm}" />
                                <GridViewColumn Header="MB" Width="80" DisplayMemberBinding="{Binding Mb, StringFormat=N0}" />
                                <GridViewColumn Header="{DynamicResource ToLevel}" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="#2BB673" Visibility="{Binding IsLevel, Converter={StaticResource BoolVis}}" /></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Command="{Binding RestoreBackupCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource ToRestore}" /></StackPanel>
                        </Button>
                        <Button Command="{Binding OpenBackupCommand}" Content="{DynamicResource LibOpenFolder}" Margin="0,0,8,0" />
                        <Button Command="{Binding DeleteBackupCommand}" Content="{DynamicResource SongDelete}" Foreground="#E5484D" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- mod settings -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ToModSettings}" Style="{StaticResource CardHeader}" />
                    <TextBlock Text="{Binding ModCfgText}" Style="{StaticResource SubText}" FontSize="12" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ModSettings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Section}" Style="{StaticResource SubText}" FontSize="11" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsBool, Converter={StaticResource NotBoolVis}}" />
                                        <CheckBox IsChecked="{Binding BoolValue}" Visibility="{Binding IsBool, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource SubText}" FontSize="12">
                                        <Run Text="{Binding Description, Mode=OneWay}" /> <Run Text="{Binding Default, Mode=OneWay, StringFormat=(default {0})}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Command="{Binding SaveModCfgCommand}" Style="{DynamicResource AccentButtonStyle}" Content="{DynamicResource SetSave}" Margin="0,0,8,0" MinWidth="90" />
                        <Button Command="{Binding ResetModCfgCommand}" Content="{DynamicResource ToDefaults}" Margin="0,0,8,0" />
                        <Button Command="{Binding OpenGameLogCommand}" Content="{DynamicResource ToGameLog}" />
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource ToModSettingsHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
