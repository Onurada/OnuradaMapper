<Window x:Class="OnuradaMapper.Views.JsonEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="720" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource JsonHint}" Style="{StaticResource SubText}" Margin="0,0,0,10" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource BtnCancel}" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                <Button Content="{DynamicResource SetSave}" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}" MinWidth="90" />
            </StackPanel>
            <TextBlock x:Name="Err" Foreground="#E5484D" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <TextBox x:Name="Box" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </DockPanel>
</Window>
