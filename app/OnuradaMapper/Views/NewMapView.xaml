<UserControl x:Class="OnuradaMapper.Views.NewMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource NmTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,18">
                <Run Text="{DynamicResource NmSubtitle}" /> <Run Text="#" FontWeight="SemiBold" /><Run Text="{Binding NextId, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>

            <!-- song -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource NmSong}" Style="{StaticResource CardHeader}" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Command="{Binding DoSearchCommand}" Margin="8,0,0,0" IsDefault="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource NmSearch}" /></StackPanel>
                        </Button>
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource NmSearchHint}" />
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding Searching, Converter={StaticResource BoolVis}}" />
                    <ItemsControl ItemsSource="{Binding Hits}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.UseHitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4" Padding="6">
                                    <DockPanel>
                                        <Border Width="96" Height="54" CornerRadius="4" ClipToBounds="True" DockPanel.Dock="Left" Background="#20FFFFFF">
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" VerticalAlignment="Center" Margin="8,0" Style="{StaticResource SubText}" />
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Channel}" Style="{StaticResource SubText}" FontSize="12" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{DynamicResource NmFromYouTube}" IsChecked="{Binding FromYouTube}" Margin="0,0,24,0" />
                        <RadioButton Content="{DynamicResource NmFromFile}" IsChecked="{Binding FromYouTube, Converter={StaticResource Not}}" />
                    </StackPanel>
                    <DockPanel Margin="0,10,0,0" Visibility="{Binding FromYouTube, Converter={StaticResource BoolVis}}">
                        <Button DockPanel.Dock="Right" Command="{Binding FetchInfoCommand}" Content="{DynamicResource NmFetch}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" ToolTip="https://www.youtube.com/watch?v=..." />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0" Visibility="{Binding FromYouTube, Converter={StaticResource NotBoolVis}}">
                        <Button DockPanel.Dock="Right" Command="{Binding BrowseAudioCommand}" Content="{DynamicResource Browse}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding AudioFile}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource NmSourceHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,6,0,0" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource NmSongTitle}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource NmArtist}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource NmLanguage}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource NmBpm}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Bpm, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource NmBpmHint}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource NmCover}" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding BrowseCoverCommand}" Content="{DynamicResource Browse}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding CoverFile}" ToolTip="{DynamicResource NmCoverHint}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource NmCoverHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- look -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource NmLook}" Style="{StaticResource CardHeader}" />
                    <TextBlock Text="{DynamicResource NmEnv}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Envs}" SelectedItem="{Binding Env}" HorizontalAlignment="Left" MinWidth="320" />
                    <TextBlock Text="{DynamicResource NmEnvHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,6,0,0" />
                    <CheckBox Content="{DynamicResource NmAutoColors}" IsChecked="{Binding AutoColors}" Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding AutoColors, Converter={StaticResource NotBoolVis}}">
                        <TextBlock Text="{DynamicResource NmSaberA}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Width="26" Height="26" CornerRadius="13" Background="{Binding ColorA, Converter={StaticResource HexBrush}}" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ColorA, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,24,0" />
                        <TextBlock Text="{DynamicResource NmSaberB}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Width="26" Height="26" CornerRadius="13" Background="{Binding ColorB, Converter={StaticResource HexBrush}}" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ColorB, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- show -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource NmShow}" Style="{StaticResource CardHeader}" />

                    <TextBlock Text="{DynamicResource NmDream}" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource NmDreamHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,2,0,8" />
                    <WrapPanel>
                        <RadioButton GroupName="dream" Content="{DynamicResource NmDreamAuto}" IsChecked="{Binding Dream, Converter={StaticResource IntIs}, ConverterParameter=0}" Margin="0,0,24,0" />
                        <RadioButton GroupName="dream" Content="{DynamicResource NmDreamVoice}" IsChecked="{Binding Dream, Converter={StaticResource IntIs}, ConverterParameter=1}" Margin="0,0,24,0" />
                        <RadioButton GroupName="dream" Content="{DynamicResource NmDreamOff}" IsChecked="{Binding Dream, Converter={StaticResource IntIs}, ConverterParameter=2}" />
                    </WrapPanel>
                    <Border Visibility="{Binding Dream, Converter={StaticResource IntVis}, ConverterParameter=1}" Margin="24,10,0,0" Padding="14,10"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource NmVoiceHint}" Style="{StaticResource SubText}" FontSize="12" />
                            <WrapPanel Margin="0,8,0,0">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource NmVoiceRef}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding VoiceRefs}" SelectedItem="{Binding VoiceRef}" MinWidth="240" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource NmVoiceStart}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding VoiceStart, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="1:40" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource NmVoiceEnd}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding VoiceEnd, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="1:57" />
                                </StackPanel>
                                <Button Content="{DynamicResource NmZoktay}" Command="{Binding ZoktayPresetCommand}" VerticalAlignment="Bottom"
                                        Visibility="{Binding ZoktayAvailable, Converter={StaticResource BoolVis}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding Dream, Converter={StaticResource IntVis}, ConverterParameter=0|1}">
                        <TextBlock Text="{DynamicResource NmVideo}" FontWeight="SemiBold" Margin="0,16,0,8" />
                        <WrapPanel>
                            <RadioButton GroupName="video" Content="{DynamicResource NmVideoNone}" IsChecked="{Binding Video, Converter={StaticResource IntIs}, ConverterParameter=0}" Margin="0,0,24,0" />
                            <RadioButton GroupName="video" Content="Zoktay" IsChecked="{Binding Video, Converter={StaticResource IntIs}, ConverterParameter=1}" Margin="0,0,24,0"
                                         Visibility="{Binding ZoktayAvailable, Converter={StaticResource BoolVis}}" />
                            <RadioButton GroupName="video" Content="{DynamicResource NmVideoFile}" IsChecked="{Binding Video, Converter={StaticResource IntIs}, ConverterParameter=2}" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding Video, Converter={StaticResource IntVis}, ConverterParameter=2}" Margin="24,8,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding BrowseVideoCommand}" Content="{DynamicResource Browse}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding VideoFile}" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource NmVideoStart}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding VideoStart, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource NmVideoHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource NmKaraoke}" FontWeight="SemiBold" Margin="0,16,0,8" />
                    <WrapPanel>
                        <RadioButton GroupName="kara" Content="{DynamicResource NmKaraokeDream}" IsChecked="{Binding Karaoke, Converter={StaticResource IntIs}, ConverterParameter=0}" Margin="0,0,24,0" />
                        <RadioButton GroupName="kara" Content="{DynamicResource NmKaraokeAll}" IsChecked="{Binding Karaoke, Converter={StaticResource IntIs}, ConverterParameter=1}" Margin="0,0,24,0" />
                        <RadioButton GroupName="kara" Content="{DynamicResource NmKaraokeOff}" IsChecked="{Binding Karaoke, Converter={StaticResource IntIs}, ConverterParameter=2}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Command="{Binding CreateCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="24,10" FontSize="15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,10,0" />
                        <TextBlock Text="{DynamicResource NmCreate}" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding AddToQueueCommand}" Padding="16,10" Margin="0,0,10,0" ToolTip="{DynamicResource NmQueueHint}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE902;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource NmAddQueue}" /></StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <CheckBox Content="{DynamicResource NmInstall}" IsChecked="{Binding Install}" />
                    <TextBlock Text="{DynamicResource NmTimeHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,6,16,0" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Error}" Foreground="#E5484D" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding Error, Converter={StaticResource EmptyVis}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
