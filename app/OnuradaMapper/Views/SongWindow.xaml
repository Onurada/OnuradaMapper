<Window x:Class="OnuradaMapper.Views.SongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:OnuradaMapper.Views"
        Width="1240" Height="860" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterOwner" Icon="/Assets/app.ico">
    <Grid Margin="24,18,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel>
            <Border Width="96" Height="96" CornerRadius="10" ClipToBounds="True" Background="{StaticResource BrandGradient}" DockPanel.Dock="Left" ToolTip="{DynamicResource CoverHint}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource CoverFromFile}" Command="{Binding ChangeCoverCommand}" CommandParameter="file" />
                        <MenuItem Header="{DynamicResource CoverGenerate}" Command="{Binding ChangeCoverCommand}" CommandParameter="generate" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
            </Border>
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Command="{Binding SaveOnlyCommand}" Margin="0,0,8,0" ToolTip="Ctrl+S">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource SetSave}" /></StackPanel>
                </Button>
                <Button Command="{Binding SaveAndBuildCommand}" Style="{DynamicResource AccentButtonStyle}" ToolTip="Ctrl+B">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource SongSaveBuild}" /></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}" FontSize="15" Style="{StaticResource SubText}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Id, StringFormat=#{0}}" Style="{StaticResource SubText}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Info}" Style="{StaticResource SubText}" />
                    <TextBlock Text="  ●" Foreground="#FFD21F" Visibility="{Binding Dirty, Converter={StaticResource BoolVis}}" ToolTip="{DynamicResource SongUnsaved}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- transport -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,14,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Command="{Binding Player.BackCommand}" ToolTip="-5 s"><TextBlock Text="&#xE892;" Style="{StaticResource Icon}" /></Button>
                    <Button Command="{Binding Player.ToggleCommand}" Margin="6,0" Width="48" ToolTip="Space">
                        <Grid>
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Visibility="{Binding Player.IsPlaying, Converter={StaticResource NotBoolVis}}" />
                            <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" Visibility="{Binding Player.IsPlaying, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding Player.ForwardCommand}" ToolTip="+5 s"><TextBlock Text="&#xE893;" Style="{StaticResource Icon}" /></Button>
                    <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="14,0" FontFamily="Cascadia Mono, Consolas" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                    <Slider Width="120" Minimum="0" Maximum="1" Value="{Binding Player.Volume}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource SubText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" x:Name="Tabs">
            <!-- timeline -->
            <TabItem Header="{DynamicResource TabTimeline}">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource TlHelp}" Style="{StaticResource SubText}" FontSize="12" Margin="0,10,0,0" />
                    <Border Style="{StaticResource Card}" Padding="0" MaxHeight="560" VerticalAlignment="Stretch">
                        <v:TimelineControl x:Name="Timeline" />
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- preview -->
            <TabItem Header="{DynamicResource TabPreview}">
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource SongDifficulty}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding DiffNames}" SelectedIndex="{Binding PreviewDiff}" MinWidth="160" />
                        <TextBlock Text="{DynamicResource PreviewHint}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>
                    <Border CornerRadius="8" ClipToBounds="True" Background="Black">
                        <v:PreviewControl x:Name="Preview" />
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- lyrics -->
            <TabItem Header="{DynamicResource TabLyrics}">
                <DockPanel Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Command="{Binding PlayWordCommand}" Margin="0,0,6,0" ToolTip="Enter">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,6,0" /><TextBlock Text="{DynamicResource LyPlay}" /></StackPanel>
                        </Button>
                        <Button Command="{Binding SetWordToPlayheadCommand}" Content="{DynamicResource LyToPlayhead}" Margin="0,0,6,0" ToolTip="T" />
                        <Button Command="{Binding ShiftWordsCommand}" CommandParameter="-0.05" Content="-50 ms" Margin="0,0,6,0" ToolTip="{DynamicResource LyShiftHint}" />
                        <Button Command="{Binding ShiftWordsCommand}" CommandParameter="0.05" Content="+50 ms" Margin="0,0,16,0" ToolTip="{DynamicResource LyShiftHint}" />
                        <Button Command="{Binding ShiftAllCommand}" CommandParameter="-0.1" Content="{DynamicResource LyAllEarlier}" Margin="0,0,6,0" />
                        <Button Command="{Binding ShiftAllCommand}" CommandParameter="0.1" Content="{DynamicResource LyAllLater}" Margin="0,0,16,0" />
                        <Button Command="{Binding AddWordCommand}" Content="{DynamicResource LyAdd}" Margin="0,0,6,0" />
                        <Button Command="{Binding DeleteWordCommand}" Content="{DynamicResource LyDelete}" Margin="0,0,16,0" />
                        <Button Command="{Binding RestoreWordsCommand}" Content="{DynamicResource LyRestore}" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource LyHelp}" Style="{StaticResource SubText}" FontSize="12" Margin="0,8,0,0" />
                    <DataGrid x:Name="WordGrid" ItemsSource="{Binding Words}" SelectedItem="{Binding SelectedWord}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource LyTime}" Binding="{Binding Start, StringFormat=0.000}" Width="110" />
                            <DataGridTextColumn Header="{DynamicResource LyWord}" Binding="{Binding Word, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="p" Binding="{Binding P, StringFormat=0.00}" Width="70" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- overview + tuning -->
            <TabItem Header="{DynamicResource TabOverview}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SongStats}" Style="{StaticResource CardHeader}" />
                                <DataGrid ItemsSource="{Binding Stats}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="" Binding="{Binding Name}" Width="100" />
                                        <DataGridTextColumn Header="{DynamicResource StNotes}" Binding="{Binding Notes}" Width="70" />
                                        <DataGridTextColumn Header="NPS" Binding="{Binding Nps}" Width="60" />
                                        <DataGridTextColumn Header="NJS" Binding="{Binding Njs}" Width="60" />
                                        <DataGridTextColumn Header="{DynamicResource StArcs}" Binding="{Binding Arcs}" Width="60" />
                                        <DataGridTextColumn Header="{DynamicResource StChains}" Binding="{Binding Chains}" Width="70" />
                                        <DataGridTextColumn Header="{DynamicResource StBombs}" Binding="{Binding Bombs}" Width="70" />
                                        <DataGridTextColumn Header="{DynamicResource StWalls}" Binding="{Binding Walls}" Width="70" />
                                        <DataGridTextColumn Header="{DynamicResource StSources}" Binding="{Binding Sources}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{DynamicResource StSourcesHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SongTuning}" Style="{StaticResource CardHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource NmEnv}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Envs}" SelectedItem="{Binding Env}" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="{DynamicResource TuDensity}" Style="{StaticResource FieldLabel}" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Density, StringFormat=×{0:0.00}}" Width="48" VerticalAlignment="Center" TextAlignment="Right" />
                                            <Slider Minimum="0.5" Maximum="1.6" Value="{Binding Density}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                        </DockPanel>
                                        <TextBlock Text="{DynamicResource TuVocal}" Style="{StaticResource FieldLabel}" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding VocalWeight, StringFormat=0.00}" Width="48" VerticalAlignment="Center" TextAlignment="Right" />
                                            <Slider Minimum="0" Maximum="1.5" Value="{Binding VocalWeight}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                        </DockPanel>
                                        <TextBlock Text="{DynamicResource TuVocalHint}" Style="{StaticResource SubText}" FontSize="12" />
                                        <TextBlock Text="{DynamicResource TuLyricsOffset}" Style="{StaticResource FieldLabel}" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LyricsOffset, StringFormat={}{0:+0.00;-0.00;0} s}" Width="60" VerticalAlignment="Center" TextAlignment="Right" />
                                            <Slider Minimum="-1" Maximum="1" Value="{Binding LyricsOffset}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource TuColors}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{Binding ColorA, Converter={StaticResource HexBrush}}" Margin="0,0,6,0" />
                                            <TextBox Text="{Binding ColorA, UpdateSourceTrigger=PropertyChanged}" Width="96" Margin="0,0,18,0" />
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{Binding ColorB, Converter={StaticResource HexBrush}}" Margin="0,0,6,0" />
                                            <TextBox Text="{Binding ColorB, UpdateSourceTrigger=PropertyChanged}" Width="96" />
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource TuNjs}" Style="{StaticResource FieldLabel}" />
                                        <UniformGrid Columns="5">
                                            <StackPanel Margin="0,0,4,0"><TextBlock Text="E" FontSize="11" Style="{StaticResource SubText}" /><TextBox Text="{Binding NjsE}" /></StackPanel>
                                            <StackPanel Margin="0,0,4,0"><TextBlock Text="N" FontSize="11" Style="{StaticResource SubText}" /><TextBox Text="{Binding NjsN}" /></StackPanel>
                                            <StackPanel Margin="0,0,4,0"><TextBlock Text="H" FontSize="11" Style="{StaticResource SubText}" /><TextBox Text="{Binding NjsH}" /></StackPanel>
                                            <StackPanel Margin="0,0,4,0"><TextBlock Text="X" FontSize="11" Style="{StaticResource SubText}" /><TextBox Text="{Binding NjsX}" /></StackPanel>
                                            <StackPanel><TextBlock Text="X+" FontSize="11" Style="{StaticResource SubText}" /><TextBox Text="{Binding NjsXP}" /></StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="{DynamicResource TuNjsHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,4,0,0" />
                                        <CheckBox Content="{DynamicResource TuHearts}" IsChecked="{Binding Hearts}" Margin="0,14,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                                            <TextBlock Text="{DynamicResource TuMaxHearts}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding MaxHearts}" Width="60" />
                                        </StackPanel>
                                        <CheckBox Content="{DynamicResource TuDust}" IsChecked="{Binding Dust}" Margin="0,10,0,0" />
                                        <CheckBox Content="{DynamicResource TuCombo}" IsChecked="{Binding Combo}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SongActions}" Style="{StaticResource CardHeader}" />
                                <WrapPanel>
                                    <Button Command="{Binding RerollCommand}" Margin="0,0,8,8" ToolTip="{DynamicResource SongRerollHint}">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B1;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource SongReroll}" /></StackPanel>
                                    </Button>
                                    <Button Command="{Binding OriginalSeedCommand}" Margin="0,0,8,8" Content="{DynamicResource SongOriginal}" />
                                    <Button Command="{Binding RestoryCommand}" Margin="0,0,8,8" ToolTip="{DynamicResource SongRestoryHint}">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource SongRestory}" /></StackPanel>
                                    </Button>
                                    <Button Command="{Binding InstallCommand}" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource LibInstall}" /></StackPanel>
                                    </Button>
                                    <Button Command="{Binding ExportZipCommand}" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xF012;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource SongZip}" /></StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenFolderCommand}" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource LibOpenFolder}" /></StackPanel>
                                    </Button>
                                    <Button Command="{Binding EditJsonCommand}" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="JSON" /></StackPanel>
                                    </Button>
                                    <Button Command="{Binding DeleteCommand}" Margin="0,0,8,8" Foreground="#E5484D">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource SongDelete}" /></StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource SubText}" FontSize="12">
                                    <Run Text="seed:" /> <Run Text="{Binding Seed, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- running job -->
        <Border Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding Job.IsRunning, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Job.Status}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <ProgressBar Value="{Binding Job.Progress}" Maximum="100" Height="4" Foreground="{StaticResource Brand}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
