<UserControl x:Class="OnuradaMapper.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource SetTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SetMapper}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding MapperName, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left" />
                    <TextBlock Text="{DynamicResource SetMapperHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,4,0,0" />

                    <TextBlock Text="{DynamicResource SetLanguage}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="260" HorizontalAlignment="Left" />

                    <TextBlock Text="{DynamicResource SetTheme}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="260" HorizontalAlignment="Left" />

                    <CheckBox Content="{DynamicResource SetInstallAfter}" IsChecked="{Binding InstallAfterBuild}" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SetWorkspace}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Command="{Binding BrowseWorkspaceCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Workspace}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource SetWorkspaceHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,4,0,0" />

                    <TextBlock Text="{DynamicResource SetGame}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Command="{Binding BrowseGameCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding GameDir}" />
                    </DockPanel>

                    <TextBlock Text="{DynamicResource SetPython}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Command="{Binding BrowsePythonCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding PythonPath}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource SetPythonHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SetDevice}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Device}" Width="260" HorizontalAlignment="Left" />
                    <TextBlock Text="{DynamicResource SetWhisper}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                    <ComboBox ItemsSource="{Binding WhisperModels}" SelectedItem="{Binding Whisper}" Width="260" HorizontalAlignment="Left" />
                    <TextBlock Text="{DynamicResource SetWhisperHint}" Style="{StaticResource SubText}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource SetSave}" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="24,8" />
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource SubText}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
