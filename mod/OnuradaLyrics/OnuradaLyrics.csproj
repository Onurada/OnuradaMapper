<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>OnuradaLyrics</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- dotnet build -p:GameDir="D:\Games\Beat Saber" for another install -->
    <GameDir Condition="'$(GameDir)' == ''">$(USERPROFILE)\Desktop\Beat Saber</GameDir>
    <BS>$(GameDir)\Beat Saber_Data\Managed</BS>
    <BEP>$(GameDir)\BepInEx\core</BEP>
    <Version>1.9.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BEP)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BEP)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(BS)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(BS)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(BS)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(BS)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(BS)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(BS)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(BS)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Main"><HintPath>$(BS)\Main.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GameplayCore"><HintPath>$(BS)\GameplayCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BeatmapCore"><HintPath>$(BS)\BeatmapCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BeatSaber.Haptics"><HintPath>$(BS)\BeatSaber.Haptics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.XRModule"><HintPath>$(BS)\UnityEngine.XRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(BS)\netstandard.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
